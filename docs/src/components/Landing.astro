---
import { Code } from '@astrojs/starlight/components';

/**
 * Landing page of the docs (`/` and `/fr/`).
 * Structure borrowed from paykit.sh (framed page, ruled sections, app + backend demo),
 * openship.io (centered hero under the install command, dark inset slab, numbered setup)
 * and multica.ai (the product UI sitting on the hero). The memorable part is the playable
 * demo: a fake app on the left, the log the bundle would write on the right.
 */
const locale = Astro.locals.starlightRoute.locale;
const lang = locale === 'fr' ? 'fr' : 'en';
const prefix = locale ? `/${locale}` : '';
const link = (path: string) => `${prefix}${path}`;

const copy = {
	en: {
		title: 'Stripe billing for Symfony, without the glue code.',
		lead: 'Declare plans in YAML, gate features, meter usage. The bundle runs Checkout, plan changes and webhooks, and keeps billing state in your own database.',
		primary: 'Read the introduction',
		secondary: 'Install the bundle',
		copyLabel: 'Copy the install command',
		copied: 'Copied',
		status: 'Version 0.1, experimental. PHP 8.2+, Symfony 7.1+, Doctrine ORM 3.',
		demo: {
			label: 'Playable demo of the bundle',
			log: 'Symfony log',
			free: 'Free',
			pro: 'Pro',
			freeMeta: '3 messages a month',
			proMeta: '$19 a month, 100 messages',
			current: 'Current plan',
			upgrade: 'Upgrade to Pro',
			downgrade: 'Switch to Free',
			keep: 'Keep Pro',
			scheduled: 'Switches to Free at the end of the period',
			paying: 'Waiting for Stripe Checkout…',
			send: 'Send a message',
			left: 'messages left this month',
			unlimitedHint: 'Pro includes 100 messages a month.',
			blocked: 'You have used your 3 messages this month. Upgrade to keep chatting.',
			sent: 'Message sent.',
			reset: 'Reset demo',
			empty: 'Use the app on the left: every call the bundle makes shows up here.',
		},
		stepsTitle: 'From composer require to gated features',
		stepsLead: 'Four steps, each one a command or a few lines of config.',
		steps: [
			['Install', 'Add the bundle and create its tables with the migration it ships.'],
			['Declare', 'Describe features and plans in config/packages/paykit.yaml.'],
			['Push', 'paykit:push creates the Stripe products and prices, and versions them.'],
			['Gate', 'Protect a controller and count usage with one attribute.'],
		],
		gridTitle: 'What the bundle covers',
		grid: [
			['Plans in config', 'Features, groups, add-ons and trials, validated when the container compiles.', '/guides/plans/'],
			['Every plan change', 'subscribe() handles Checkout, prorated upgrades, scheduled downgrades and resumes.', '/guides/subscriptions/'],
			['Usage metering', 'An atomic report(), grants that stack across plans, resets without a cron.', '/guides/entitlements/'],
			['Access control', 'The #[RequiresFeature] attribute, the PAYKIT_FEATURE voter and Twig functions.', '/guides/access-control/'],
			['Idempotent webhooks', 'Each Stripe event is applied once. Failures are retried, duplicates skipped.', '/guides/webhooks/'],
			['Tests without Stripe', 'A fake provider records calls and replays webhooks.', '/guides/testing/'],
		],
		portTitle: 'Coming from PayKit?',
		portLead: 'This bundle is a Symfony port of PayKit, the billing framework for TypeScript. The concepts carry over.',
		portRows: [
			['plan({ id, price, includes })', 'paykit.plans.<id> in YAML'],
			['paykit.subscribe({...})', '$payKit->subscribe()'],
			['paykitjs push', 'bin/console paykit:push'],
		],
		portLink: 'Full mapping',
		ctaTitle: 'Add billing to your Symfony app',
		ctaLead: 'Install the bundle, declare a plan, and protect your first feature.',
		ctaPrimary: 'Install the bundle',
		ctaSecondary: 'Try the Playground',
	},
	fr: {
		title: 'La facturation Stripe pour Symfony, sans code de colle.',
		lead: "Déclarez vos offres en YAML, contrôlez l'accès aux fonctionnalités, mesurez l'usage. Le bundle gère le Checkout, les changements d'offre et les webhooks, et garde l'état de facturation dans votre propre base.",
		primary: "Lire l'introduction",
		secondary: 'Installer le bundle',
		copyLabel: "Copier la commande d'installation",
		copied: 'Copié',
		status: 'Version 0.1, expérimentale. PHP 8.2+, Symfony 7.1+, Doctrine ORM 3.',
		demo: {
			label: 'Démo jouable du bundle',
			log: 'Log Symfony',
			free: 'Gratuite',
			pro: 'Pro',
			freeMeta: '3 messages par mois',
			proMeta: '19 $ par mois, 100 messages',
			current: 'Offre actuelle',
			upgrade: 'Passer à Pro',
			downgrade: "Revenir à l'offre gratuite",
			keep: 'Garder Pro',
			scheduled: "Bascule vers l'offre gratuite en fin de période",
			paying: 'En attente du Checkout Stripe…',
			send: 'Envoyer un message',
			left: 'messages restants ce mois-ci',
			unlimitedHint: "L'offre Pro inclut 100 messages par mois.",
			blocked: 'Vous avez utilisé vos 3 messages ce mois-ci. Passez à Pro pour continuer.',
			sent: 'Message envoyé.',
