			['Installer', 'Ajoutez le bundle et créez ses tables avec la migration fournie.'],
			['Déclarer', 'Décrivez fonctionnalités et offres dans config/packages/paykit.yaml.'],
			['Pousser', 'paykit:push crée les produits et prix Stripe, et les versionne.'],
			['Protéger', "Protégez un contrôleur et comptez l'usage avec un seul attribut."],
		],
		gridTitle: 'Ce que couvre le bundle',
		grid: [
			['Offres dans la config', 'Fonctionnalités, groupes, options et essais, validés à la compilation du conteneur.', '/guides/plans/'],
			["Chaque changement d'offre", 'subscribe() gère le Checkout, les montées au prorata, les descentes programmées et les reprises.', '/guides/subscriptions/'],
			["Mesure d'usage", 'Un report() atomique, des droits cumulés entre offres, des remises à zéro sans cron.', '/guides/entitlements/'],
			["Contrôle d'accès", "L'attribut #[RequiresFeature], le voter PAYKIT_FEATURE et des fonctions Twig.", '/guides/access-control/'],
			['Webhooks idempotents', 'Chaque événement Stripe est appliqué une fois. Les échecs sont rejoués, les doublons ignorés.', '/guides/webhooks/'],
			['Tests sans Stripe', 'Un fournisseur factice enregistre les appels et rejoue les webhooks.', '/guides/testing/'],
		],
		portTitle: 'Vous venez de PayKit ?',
		portLead: 'Ce bundle est un portage Symfony de PayKit, le framework de facturation pour TypeScript. Les concepts restent les mêmes.',
		portRows: [
			['plan({ id, price, includes })', 'paykit.plans.<id> en YAML'],
			['paykit.subscribe({...})', '$payKit->subscribe()'],
			['paykitjs push', 'bin/console paykit:push'],
		],
		portLink: 'Correspondance complète',
		ctaTitle: 'Ajoutez la facturation à votre app Symfony',
		ctaLead: 'Installez le bundle, déclarez une offre et protégez votre première fonctionnalité.',
		ctaPrimary: 'Installer le bundle',
		ctaSecondary: 'Essayer le Playground',
	},
}[lang];

const install = 'composer require makfly/paykit-bundle';
/** Lucide-style glyphs for the capability grid, keyed by guide path. */
const icons: Record<string, string> = {
	'/guides/plans/': '<path d="M4 6h16M4 12h16M4 18h10" />',
	'/guides/subscriptions/': '<path d="M4 12a8 8 0 0 1 14-5.3L20 9" /><path d="M20 4v5h-5" /><path d="M20 12a8 8 0 0 1-14 5.3L4 15" /><path d="M4 20v-5h5" />',
	'/guides/entitlements/': '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2" />',
	'/guides/access-control/': '<rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" />',
	'/guides/webhooks/': '<path d="M13 2 4 14h7l-1 8 9-12h-7Z" />',
	'/guides/testing/': '<path d="M9 3h6M10 3v6L4 19a2 2 0 0 0 2 3h12a2 2 0 0 0 2-3l-6-10V3" />',
};
const stepCode = [
	{
		lang: 'bash',
		title: '',
		code: `composer require makfly/paykit-bundle
php bin/console doctrine:migrations:migrate`,
	},
	{
		lang: 'yaml',
		title: 'config/packages/paykit.yaml',
		code: `paykit:
    features:
        messages: metered
        pro_models: boolean
    plans:
        free:
            group: base
            default: true
            includes:
                messages: { limit: 3, reset: month }
        pro:
            group: base
            price: { amount: 19, interval: month }
            includes:
                messages: { limit: 100, reset: month }
                pro_models: ~`,
	},
	{
		lang: 'bash',
		title: '',
		code: `php bin/console paykit:push --dry-run   # preview
php bin/console paykit:push             # create products and prices
php bin/console paykit:status --throw   # fail CI when plans drift`,
	},
	{
		lang: 'php',
		title: 'src/Controller/ChatController.php',
		code: `use PayKit\\Bundle\\Security\\RequiresFeature;

#[RequiresFeature('messages', consume: 1)]   // 402 when the quota is spent
public function chat(Request $request): Response
{
    return $this->json($this->assistant->reply($request));
}`,
	},
];
---

<div class="not-content pk-landing">
	<section class="pk-hero">
		<div class="pk-glow" aria-hidden="true"><span></span><span></span></div>
		<pk-copy-install class="pk-command pk-reveal" style="--i: 0" data-copied={copy.copied}>
			<code>{install}</code>
			<button type="button" data-command={install} aria-label={copy.copyLabel}>
				<svg class="pk-i-copy" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="13" height="13" rx="2" /><path d="M4 16V5a1 1 0 0 1 1-1h11" /></svg>
				<svg class="pk-i-check" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L20 7" /></svg>
			</button>
		</pk-copy-install>
		<h1 id="_top" class="pk-reveal" style="--i: 1">{copy.title}</h1>
		<p class="pk-lead pk-reveal" style="--i: 2">{copy.lead}</p>
		<div class="pk-actions pk-reveal" style="--i: 3">
			<a class="pk-btn pk-btn-primary" href={link('/introduction/')}>{copy.primary}</a>
			<a class="pk-btn" href={link('/getting-started/installation/')}>{copy.secondary}</a>
		</div>
		<p class="pk-status pk-reveal" style="--i: 4">{copy.status}</p>
	</section>

	<section class="pk-slab pk-reveal" style="--i: 5" aria-label={copy.demo.label}>
		<pk-demo class="pk-demo" data-copy={JSON.stringify(copy.demo)}>
			<div class="pk-window pk-app">
				<div class="pk-window-bar">
					<span class="pk-dots" aria-hidden="true"><i></i><i></i><i></i></span>
					<span class="pk-url">localhost:8000/chat</span>
					<button type="button" class="pk-reset" data-reset>{copy.demo.reset}</button>
				</div>
				<div class="pk-app-body">
					<div class="pk-plans" role="group" aria-label={copy.demo.current}>
						<div class="pk-plan" data-plan="free">
							<div class="pk-plan-head">
								<span class="pk-plan-name">{copy.demo.free}</span>
								<span class="pk-plan-tag" data-tag="free">{copy.demo.current}</span>
							</div>
							<span class="pk-plan-meta">{copy.demo.freeMeta}</span>
							<button type="button" class="pk-plan-btn" data-action="downgrade">{copy.demo.downgrade}</button>
						</div>
						<div class="pk-plan" data-plan="pro">
							<div class="pk-plan-head">
								<span class="pk-plan-name">{copy.demo.pro}</span>
								<span class="pk-plan-tag" data-tag="pro">{copy.demo.current}</span>
							</div>
							<span class="pk-plan-meta">{copy.demo.proMeta}</span>
							<button type="button" class="pk-plan-btn" data-action="upgrade">{copy.demo.upgrade}</button>
						</div>
						<p class="pk-plan-note" data-note hidden></p>
					</div>
					<div class="pk-chat">
						<div class="pk-quota">
							<span class="pk-quota-count" data-count>3</span>
							<span class="pk-quota-label">{copy.demo.left}</span>
						</div>
						<div class="pk-meter" aria-hidden="true"><span data-meter></span></div>
						<p class="pk-chat-msg" data-msg aria-live="polite"></p>
						<button type="button" class="pk-send" data-action="send">{copy.demo.send}</button>
					</div>
				</div>
			</div>

			<div class="pk-window pk-log">
				<div class="pk-window-bar">
					<span class="pk-log-title">{copy.demo.log}</span>
					<span class="pk-log-channel">paykit</span>
				</div>
				<ol class="pk-log-lines" data-log aria-live="polite">
					<li class="pk-log-empty">{copy.demo.empty}</li>
				</ol>
			</div>
		</pk-demo>
	</section>

	<section class="pk-band" aria-labelledby="pk-steps-title">
		<div class="pk-band-head">
			<h2 id="pk-steps-title">{copy.stepsTitle}</h2>
			<p>{copy.stepsLead}</p>
		</div>
		<pk-steps class="pk-steps">
			<ol class="pk-step-list" role="tablist" aria-orientation="vertical">
				{
					copy.steps.map(([title, text], i) => (
						<li role="presentation">
							<button
								type="button"
								role="tab"
								id={`pk-step-tab-${i}`}
								aria-controls={`pk-step-panel-${i}`}
								aria-selected={i === 0 ? 'true' : 'false'}
								tabindex={i === 0 ? 0 : -1}
							>
								<span class="pk-step-num" aria-hidden="true">{i + 1}</span>
								<span class="pk-step-text">
									<span class="pk-step-title">{title}</span>
									<span class="pk-step-desc">{text}</span>
								</span>
							</button>
						</li>
					))
				}
			</ol>
			<div class="pk-step-panels">
				{
					stepCode.map((step, i) => (
						<div role="tabpanel" id={`pk-step-panel-${i}`} aria-labelledby={`pk-step-tab-${i}`} hidden={i !== 0}>
							{step.title ? (
								<Code code={step.code} lang={step.lang} title={step.title} />
							) : (
								<Code code={step.code} lang={step.lang} frame="terminal" />
							)}
						</div>
					))
				}
			</div>
		</pk-steps>
	</section>

	<section class="pk-band" aria-labelledby="pk-grid-title">
		<div class="pk-band-head">
			<h2 id="pk-grid-title">{copy.gridTitle}</h2>
		</div>
		<ul class="pk-grid">
			{
				copy.grid.map(([title, text, path]) => (
					<li>
						<a href={link(path)}>
							<span class="pk-grid-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={icons[path]} />
							</span>
							<span class="pk-grid-title">{title}</span>
							<span class="pk-grid-text">{text}</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section class="pk-band pk-port" aria-labelledby="pk-port-title">
		<div class="pk-band-head">
			<h2 id="pk-port-title">{copy.portTitle}</h2>
			<p>{copy.portLead}</p>
			<p><a class="pk-text-link" href={link('/reference/paykit-mapping/')}>{copy.portLink}</a></p>
		</div>
		<table class="pk-port-table">
			<thead>
				<tr><th scope="col">PayKit (TypeScript)</th><th scope="col">PayKit Bundle (Symfony)</th></tr>
			</thead>
			<tbody>
				{copy.portRows.map(([ts, php]) => (
					<tr><td><code>{ts}</code></td><td><code>{php}</code></td></tr>
				))}
			</tbody>
		</table>
	</section>

	<section class="pk-band pk-cta" aria-labelledby="pk-cta-title">
		<h2 id="pk-cta-title">{copy.ctaTitle}</h2>
		<p>{copy.ctaLead}</p>
		<div class="pk-actions">
			<a class="pk-btn pk-btn-primary" href={link('/getting-started/installation/')}>{copy.ctaPrimary}</a>
			<a class="pk-btn" href={link('/guides/testing/')}>{copy.ctaSecondary}</a>
		</div>
	</section>
</div>

<script>
	type DemoCopy = Record<string, string>;
	type Plan = 'free' | 'pro';
	type Line = [kind: 'call' | 'ok' | 'warn' | 'http', text: string];

	/**
	 * The demo is a small state machine that mirrors the bundle's rules:
	 * free to pro goes through Checkout and a webhook, pro to free is scheduled at period end,
	 * choosing pro again resumes it, and report() refuses when the quota is spent.
	 */
	class Demo extends HTMLElement {
		copy: DemoCopy = {};
		plan: Plan = 'free';
		pendingFree = false;
		remaining = 3;
		busy = false;
		touched = false;
		log!: HTMLOListElement;
		clock = 0;

		connectedCallback() {
			this.copy = JSON.parse(this.dataset.copy ?? '{}');
			this.log = this.querySelector('[data-log]')!;
			this.addEventListener('click', (event) => {
				const target = (event.target as HTMLElement).closest<HTMLElement>('[data-action], [data-reset]');
				if (target) this.touched = true;
				if (!target || this.busy) return;
				if (target.hasAttribute('data-reset')) return this.reset();
				const action = target.dataset.action;
				if (action === 'upgrade') this.upgrade();
				if (action === 'downgrade') this.downgrade();
				if (action === 'send') this.send();
			});
			this.render();
			this.autoplay();
		}

		/** Plays one short scenario the first time the demo scrolls into view, until the reader takes over. */
		autoplay() {
			if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			const observer = new IntersectionObserver(
				async ([entry]) => {
					if (!entry.isIntersecting) return;
					observer.disconnect();
					const pause = (ms: number) => new Promise((r) => setTimeout(r, ms));
					await pause(700);
					if (this.touched) return;
					await this.send();
					await pause(900);
					if (this.touched) return;
					await this.upgrade();
				},
				{ threshold: 0.45 }
			);
			observer.observe(this);
		}

		limit() {
			return this.plan === 'pro' ? 100 : 3;
		}

		time() {
			const base = new Date(2026, 9, 16, 10, 42, 0).getTime() + this.clock++ * 1300;
			return new Date(base).toTimeString().slice(0, 8);
		}

		write([kind, text]: Line) {
			this.log.querySelector('.pk-log-empty')?.remove();
			const line = document.createElement('li');
			line.className = `pk-line pk-line-${kind}`;
			const time = document.createElement('span');
			time.className = 'pk-line-time';
			time.textContent = this.time();
			const body = document.createElement('span');
			body.className = 'pk-line-body';
			body.textContent = text;
			line.append(time, body);
			this.log.append(line);
			this.log.scrollTop = this.log.scrollHeight;
		}

		async sequence(lines: Line[]) {
			const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
			for (const line of lines) {
				this.write(line);
				if (!reduce) await new Promise((r) => setTimeout(r, 380));
			}
		}

		async upgrade() {
			this.busy = true;
			if (this.plan === 'pro' && this.pendingFree) {
				await this.sequence([
					['call', "$payKit->subscribe('cus_42', 'pro')"],
					['ok', 'SubscribeAction::Resumed'],
					['ok', 'SubscriptionScheduledEvent  target: null'],
				]);
				this.pendingFree = false;
			} else {
				this.setMessage(this.copy.paying);
				this.render(true);
				await this.sequence([
					['call', "$payKit->subscribe('cus_42', 'pro')"],
					['ok', 'SubscribeAction::Checkout  paymentUrl: checkout.stripe.com/c/pay/…'],
					['http', 'POST /paykit/webhook  checkout.session.completed  200'],
					['ok', 'SubscriptionActivatedEvent  free -> pro'],
					['ok', 'CustomerUpdatedEvent  cus_42'],
				]);
				this.plan = 'pro';
				this.remaining = 100;
				this.setMessage(this.copy.unlimitedHint);
			}
			this.busy = false;
			this.render();
		}

		async downgrade() {
			this.busy = true;
			await this.sequence([
				['call', "$payKit->subscribe('cus_42', 'free')"],
				['warn', 'SubscribeAction::Scheduled  cancel_at_period_end: true'],
				['ok', 'SubscriptionScheduledEvent  target: free'],
			]);
			this.pendingFree = true;
			this.busy = false;
			this.render();
		}

		async send() {
			this.busy = true;
			if (this.remaining <= 0) {
				await this.sequence([
					['call', "$payKit->check('cus_42', 'messages')"],
					['warn', 'CheckResult  allowed: false  remaining: 0'],
					['http', 'POST /chat  402 Payment Required'],
				]);
				this.setMessage(this.copy.blocked, true);
			} else {
				const left = this.remaining - 1;
				await this.sequence([
					['call', "#[RequiresFeature('messages', consume: 1)]"],
					['http', 'POST /chat  200'],
					['ok', `$payKit->report('cus_42', 'messages')  remaining: ${left}`],
				]);
				this.remaining = left;
				this.setMessage(this.copy.sent);
			}
			this.busy = false;
			this.render();
		}

		reset() {
			this.plan = 'free';
			this.pendingFree = false;
			this.remaining = 3;
			this.clock = 0;
			this.log.innerHTML = '';
			const empty = document.createElement('li');
			empty.className = 'pk-log-empty';
			empty.textContent = this.copy.empty;
			this.log.append(empty);
			this.setMessage('');
			this.render();
		}

		setMessage(text: string, warn = false) {
			const msg = this.querySelector<HTMLElement>('[data-msg]')!;
			msg.textContent = text;
			msg.classList.toggle('pk-chat-warn', warn);
		}

		render(paying = false) {
			const q = <T extends HTMLElement>(s: string) => this.querySelector<T>(s)!;
			this.querySelectorAll<HTMLElement>('.pk-plan').forEach((card) => {
				card.toggleAttribute('data-current', card.dataset.plan === this.plan);
			});
			q('[data-tag="free"]').hidden = this.plan !== 'free';
			q('[data-tag="pro"]').hidden = this.plan !== 'pro';

			const upgrade = q<HTMLButtonElement>('[data-action="upgrade"]');
			const downgrade = q<HTMLButtonElement>('[data-action="downgrade"]');
			upgrade.hidden = this.plan === 'pro' && !this.pendingFree;
			upgrade.textContent = this.pendingFree ? this.copy.keep : this.copy.upgrade;
			upgrade.disabled = paying;
			downgrade.hidden = this.plan !== 'pro' || this.pendingFree;

			const note = q('[data-note]');
			note.hidden = !this.pendingFree;
			note.textContent = this.copy.scheduled;

			q('[data-count]').textContent = String(this.remaining);
			const meter = q('[data-meter]');
			meter.style.width = `${(this.remaining / this.limit()) * 100}%`;
			meter.toggleAttribute('data-empty', this.remaining === 0);
			q<HTMLButtonElement>('[data-action="send"]').disabled = paying;
		}
	}
	customElements.define('pk-demo', Demo);

	class Steps extends HTMLElement {
		connectedCallback() {
			const tabs = [...this.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
			const select = (index: number, focus = false) => {
				tabs.forEach((tab, i) => {
					const on = i === index;
					tab.setAttribute('aria-selected', String(on));
					tab.tabIndex = on ? 0 : -1;
					this.querySelector<HTMLElement>(`#${tab.getAttribute('aria-controls')}`)!.hidden = !on;
				});
				if (focus) tabs[index].focus();
			};
			tabs.forEach((tab, i) => {
				tab.addEventListener('click', () => select(i));
				tab.addEventListener('keydown', (event) => {
					if (event.key === 'ArrowDown' || event.key === 'ArrowRight') select((i + 1) % tabs.length, true);
					if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') select((i - 1 + tabs.length) % tabs.length, true);
				});
			});
		}
	}
	customElements.define('pk-steps', Steps);

	class CopyInstall extends HTMLElement {
		connectedCallback() {
			const button = this.querySelector('button')!;
			const label = button.getAttribute('aria-label') ?? '';
			button.addEventListener('click', async () => {
				await navigator.clipboard.writeText(button.dataset.command ?? '');
				button.dataset.copied = '';
				button.setAttribute('aria-label', this.dataset.copied ?? '');
				setTimeout(() => {
					delete button.dataset.copied;
					button.setAttribute('aria-label', label);
				}, 2000);
			});
		}
	}
	customElements.define('pk-copy-install', CopyInstall);
