---
import MobileTableOfContents from '@astrojs/starlight/components/MobileTableOfContents.astro';

const t = Astro.locals.t;
const { toc, editUrl } = Astro.locals.starlightRoute;
const issueUrl = 'https://github.com/MakFly/paykit-bundle/issues/new';

type Heading = { depth: number; slug: string; text: string; children: Heading[] };
const flatten = (items: Heading[], level = 0): { slug: string; text: string; level: number }[] =>
	items.flatMap((item) => [{ slug: item.slug, text: item.text, level }, ...flatten(item.children, level + 1)]);
const links = toc ? flatten(toc.items as Heading[]) : [];
---

{
	toc && (
		<>
			<div class="lg:sl-hidden">
				<MobileTableOfContents />
			</div>
			<div class="pk-toc sl-hidden lg:sl-block">
				<pk-toc>
					<nav aria-labelledby="pk-toc-title">
						<h2 id="pk-toc-title">{t('pk.toc.title')}</h2>
						<div class="pk-toc-track">
							<span class="pk-toc-marker" aria-hidden="true" />
							<ul>
								{links.map((link) => (
									<li>
										<a href={`#${link.slug}`} data-slug={link.slug} style={`--level: ${link.level}`}>
											{link.text}
										</a>
									</li>
								))}
							</ul>
						</div>
					</nav>
				</pk-toc>
				<ul class="pk-toc-links">
					{editUrl && (
						<li>
							<a href={editUrl}>
								<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
								{t('pk.toc.edit')}
							</a>
						</li>
					)}
					<li>
						<a href={issueUrl}>
							<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 8v4m0 4h.01" /></svg>
							{t('pk.toc.issue')}
						</a>
					</li>
				</ul>
			</div>
		</>
	)
}

<script>
	/**
	 * Scroll spy for the desktop table of contents.
	 * The active section is the last heading that has crossed the line under the top bar;
	 * at the bottom of the page it is the last heading, so short final sections still light up.
	 * A marker slides along the rail to the active link.
	 */
	class TableOfContents extends HTMLElement {
		links: HTMLAnchorElement[] = [];
		targets: HTMLElement[] = [];
		marker: HTMLElement | null = null;
		container: HTMLElement | null = null;
		active = -1;
		pinned: number | null = null;
		frame = 0;
		unpinTimer = 0;

		connectedCallback() {
			this.links = [...this.querySelectorAll<HTMLAnchorElement>('a[data-slug]')];
			this.targets = this.links.map((link) => document.getElementById(link.dataset.slug!)!);
			this.marker = this.querySelector('.pk-toc-marker');
			this.container = this.closest('.pk-toc');

			const schedule = () => {
				cancelAnimationFrame(this.frame);
				this.frame = requestAnimationFrame(() => this.update());
			};
			addEventListener('scroll', schedule, { passive: true });
			addEventListener('resize', schedule, { passive: true });

			// A click wins over the scroll position until the jump settles: the last sections
			// of a page cannot always scroll up to the top line.
			this.links.forEach((link, index) =>
				link.addEventListener('click', () => {
					this.pin(index);
					addEventListener('scrollend', () => this.unpin(), { once: true });
				})
			);
			addEventListener('wheel', () => this.unpin(), { passive: true });
			addEventListener('touchstart', () => this.unpin(), { passive: true });
			addEventListener('keydown', () => this.unpin());

			this.update();
		}

		pin(index: number) {
			this.pinned = index;
			clearTimeout(this.unpinTimer);
			// No scrollend fires when the page is already at the target.
			this.unpinTimer = window.setTimeout(() => this.unpin(), 1200);
			this.setActive(index);
		}

		unpin() {
			if (this.pinned === null) return;
			this.pinned = null;
			clearTimeout(this.unpinTimer);
		}

		update() {
			if (this.pinned !== null) return this.setActive(this.pinned);
			const topbar = document.querySelector<HTMLElement>('.pk-topbar')?.offsetHeight ?? 64;
			const line = topbar + 32;
			const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
			let index = 0;
			if (atBottom) {
				index = this.targets.length - 1;
			} else {
				this.targets.forEach((target, i) => {
					if (target && target.getBoundingClientRect().top <= line) index = i;
				});
			}
			this.setActive(index);
		}

		setActive(index: number) {
			if (index === this.active || !this.links[index]) return;
			this.links[this.active]?.removeAttribute('aria-current');
			const link = this.links[index];
			link.setAttribute('aria-current', 'true');
			this.active = index;

			if (this.marker) {
				this.marker.style.transform = `translateY(${link.offsetTop}px)`;
				this.marker.style.height = `${link.offsetHeight}px`;
				this.marker.dataset.ready = '';
			}

			// Keep the active link visible when the list is taller than the viewport.
			const box = this.container;
			if (box && box.scrollHeight > box.clientHeight) {
				const top = link.offsetTop;
				if (top < box.scrollTop + 40 || top > box.scrollTop + box.clientHeight - 80) {
					box.scrollTo({ top: top - box.clientHeight / 3 });
				}
			}
		}
	}
	customElements.define('pk-toc', TableOfContents);
</script>

<style>
	.pk-toc {
		position: sticky;
		top: var(--sl-nav-height);
		max-height: calc(100dvh - var(--sl-nav-height));
		overflow-y: auto;
		padding: 2rem 0 3rem;
		scrollbar-width: none;
	}
	h2 {
		margin: 0 0 0.75rem;
		color: var(--pk-fg);
		font-size: 0.875rem;
		font-weight: 500;
	}
	.pk-toc-track {
		position: relative;
		border-inline-start: 1px solid var(--pk-border);
	}
	.pk-toc-marker {
		position: absolute;
		top: 0;
		inset-inline-start: -1px;
		width: 2px;
		border-radius: 2px;
		background: var(--pk-accent);
		opacity: 0;
		transition:
			transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1),
			height 0.25s cubic-bezier(0.2, 0.7, 0.2, 1),
			opacity 0.2s;
	}
	.pk-toc-marker[data-ready] {
		opacity: 1;
	}
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.pk-toc-track a {
		display: block;
		padding: 0.3125rem 0 0.3125rem calc(0.875rem + var(--level, 0) * 0.75rem);
		color: var(--pk-muted);
		font-size: 0.8125rem;
		line-height: 1.45;
		text-decoration: none;
		transition: color 0.2s;
	}
	.pk-toc-track a:hover {
		color: var(--pk-fg);
	}
	.pk-toc-track a[aria-current='true'] {
		color: var(--pk-fg);
		font-weight: 500;
	}
	.pk-toc-links {
		display: grid;
		gap: 0.625rem;
		margin: 1.5rem 0 0;
		padding: 1.5rem 0 0;
		border-top: 1px solid var(--pk-border);
		list-style: none;
	}
	.pk-toc-links a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--pk-muted);
		font-size: 0.8125rem;
		text-decoration: none;
	}
	.pk-toc-links a:hover {
		color: var(--pk-fg);
	}
	@media (prefers-reduced-motion: reduce) {
		.pk-toc-marker {
			transition: none;
		}
	}
</style>
