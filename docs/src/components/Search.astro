---
/**
 * Command palette search (Ctrl K / Cmd K, or "/").
 * Loads /search-index.json on first open and ranks pages and sections in the browser.
 * Visible strings are rendered on the server; the script reads them from data-*.
 */
const t = Astro.locals.t;
---

<pk-search
	data-loading={t('pk.search.loading')}
	data-error={t('pk.search.error')}
	data-empty={t('pk.search.empty')}
>
	<button type="button" class="pk-search-trigger" aria-label={t('pk.search.button')} aria-keyshortcuts="Control+K">
		<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
		<span class="pk-search-label">{t('pk.search.label')}</span>
		<kbd class="pk-search-kbd"><span data-mod>{t('pk.search.ctrl')}</span>K</kbd>
	</button>

	<dialog class="pk-search-dialog" aria-label={t('pk.search.button')}>
		<div class="pk-search-panel">
			<div class="pk-search-field">
				<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
				<input
					type="search"
					placeholder={t('pk.search.placeholder')}
					autocomplete="off"
					spellcheck="false"
					role="combobox"
					aria-expanded="true"
					aria-controls="pk-search-results"
					aria-autocomplete="list"
				/>
				<button type="button" class="pk-search-close" aria-label={t('pk.search.close')}>{t('pk.search.esc')}</button>
			</div>
			<div class="pk-search-body">
				<ul id="pk-search-results" role="listbox" aria-label={t('pk.search.results')}></ul>
				<p class="pk-search-empty" hidden></p>
			</div>
			<div class="pk-search-footer" aria-hidden="true">
				<span><kbd>↑</kbd><kbd>↓</kbd> {t('pk.search.move')}</span>
				<span><kbd>{t('pk.search.enter')}</kbd> {t('pk.search.open')}</span>
				<span><kbd>{t('pk.search.esc')}</kbd> {t('pk.search.dismiss')}</span>
			</div>
		</div>
	</dialog>
</pk-search>

<script>
	type SearchRecord = { title: string; section?: string; group: string; href: string; text: string; lang: string };

	const escapeHtml = (value: string) =>
		value.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
	const escapeRegExp = (value: string) => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

	class Search extends HTMLElement {
		dialog!: HTMLDialogElement;
		input!: HTMLInputElement;
		list!: HTMLUListElement;
		empty!: HTMLElement;
		records: SearchRecord[] | null = null;
		results: SearchRecord[] = [];
		selected = 0;

		connectedCallback() {
			this.dialog = this.querySelector('dialog')!;
			this.input = this.querySelector('input')!;
			this.list = this.querySelector('ul')!;
			this.empty = this.querySelector('.pk-search-empty')!;

			if (/(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
				this.querySelector('[data-mod]')!.textContent = '⌘';
				this.querySelector('.pk-search-trigger')!.setAttribute('aria-keyshortcuts', 'Meta+K');
			}

			this.querySelector('.pk-search-trigger')!.addEventListener('click', () => this.open());
			this.querySelector('.pk-search-close')!.addEventListener('click', () => this.dialog.close());
			this.dialog.addEventListener('click', (event) => {
				if (event.target === this.dialog) this.dialog.close();
			});
			this.input.addEventListener('input', () => this.search());
			this.input.addEventListener('keydown', (event) => this.onKey(event));
			this.list.addEventListener('mousemove', (event) => {
				const item = (event.target as HTMLElement).closest<HTMLElement>('[data-index]');
				if (item) this.select(Number(item.dataset.index), false);
			});

			addEventListener('keydown', (event) => {
				const target = event.target instanceof Element ? event.target : null;
				const typing = target?.closest('input, textarea, select, [contenteditable]');
				if ((event.key === 'k' || event.key === 'K') && (event.metaKey || event.ctrlKey)) {
					event.preventDefault();
					this.dialog.open ? this.dialog.close() : this.open();
				} else if (event.key === '/' && !typing && !this.dialog.open) {
					event.preventDefault();
					this.open();
				}
			});
		}

		async open() {
			this.dialog.showModal();
			this.input.select();
			if (!this.records) {
				this.showMessage(this.dataset.loading ?? '');
				try {
					const response = await fetch('/search-index.json');
					this.records = (await response.json()) as SearchRecord[];
				} catch {
					this.showMessage(this.dataset.error ?? '');
					return;
				}
			}
			this.search();
		}

		search() {
			const query = this.input.value.trim().toLowerCase();
			const lang = document.documentElement.lang;
			const records = (this.records ?? []).filter((record) => record.lang === lang);
			if (!query) {
				// Empty query: the pages themselves, as a table of contents.
				this.results = records.filter((r) => !r.section);
			} else {
				const terms = query.split(/\s+/);
				this.results = records
					.map((record) => {
						const title = record.title.toLowerCase();
						const section = (record.section ?? '').toLowerCase();
						const text = record.text.toLowerCase();
						let score = 0;
						for (const term of terms) {
							const inTitle = title.includes(term);
							const inSection = section.includes(term);
							const inText = text.includes(term);
							if (!inTitle && !inSection && !inText) return null;
							if (record.section ? inSection : inTitle) score += 10;
							if (inTitle) score += 4;
							if (inText) score += 1;
							if ((record.section ? section : title).startsWith(term)) score += 3;
						}
						return { record, score };
					})
					.filter((hit): hit is { record: SearchRecord; score: number } => hit !== null)
					.sort((a, b) => b.score - a.score)
					.slice(0, 12)
					.map((hit) => hit.record);
			}
			this.render(query);
		}

		render(query: string) {
			const terms = query ? query.split(/\s+/).map(escapeRegExp) : [];
			const mark = (value: string) => {
				const safe = escapeHtml(value);
				return terms.length ? safe.replace(new RegExp(`(${terms.join('|')})`, 'gi'), '<mark>$1</mark>') : safe;
			};
			const snippet = (text: string) => {
				if (!text) return '';
				const lower = text.toLowerCase();
				const at = terms.length ? Math.max(0, lower.indexOf(query.split(/\s+/)[0])) : 0;
				const start = Math.max(0, at - 40);
				return (start > 0 ? '…' : '') + text.slice(start, start + 140) + (start + 140 < text.length ? '…' : '');
			};

			if (this.results.length === 0) {
				this.list.innerHTML = '';
				const template = this.dataset.empty ?? '';
				this.showMessage(template.replaceAll('{query}', this.input.value.trim()));
				return;
			}
			this.empty.hidden = true;
			this.list.innerHTML = this.results
				.map(
					(r, i) => `
					<li role="option" id="pk-search-${i}" data-index="${i}">
						<a href="${r.href}">
							<span class="pk-hit-path">${escapeHtml(r.group)}${r.section ? `<span aria-hidden="true"> / </span>${escapeHtml(r.title)}` : ''}</span>
							<span class="pk-hit-title">${mark(r.section ?? r.title)}</span>
							${query ? `<span class="pk-hit-text">${mark(snippet(r.text))}</span>` : ''}
						</a>
					</li>`
				)
				.join('');
			this.select(0);
		}

		select(index: number, scroll = true) {
			const items = this.list.querySelectorAll<HTMLElement>('[role="option"]');
			if (!items.length) return;
			this.selected = (index + items.length) % items.length;
			items.forEach((item, i) => item.setAttribute('aria-selected', String(i === this.selected)));
			this.input.setAttribute('aria-activedescendant', `pk-search-${this.selected}`);
			if (scroll) items[this.selected].scrollIntoView({ block: 'nearest' });
		}

		onKey(event: KeyboardEvent) {
			if (event.key === 'ArrowDown') {
				event.preventDefault();
				this.select(this.selected + 1);
			} else if (event.key === 'ArrowUp') {
				event.preventDefault();
				this.select(this.selected - 1);
			} else if (event.key === 'Enter') {
				const result = this.results[this.selected];
				if (result) {
					event.preventDefault();
					this.dialog.close();
					location.href = result.href;
				}
			}
		}

		showMessage(message: string) {
			this.list.innerHTML = '';
			this.empty.textContent = message;
			this.empty.hidden = false;
		}
	}
	customElements.define('pk-search', Search);
</script>

<style>
	.pk-search-trigger svg {
		flex-shrink: 0;
	}
	.pk-search-label {
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
	}
	.pk-search-trigger {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		height: 2.25rem;
		width: 2.25rem;
		justify-content: center;
		border: 1px solid var(--pk-border);
		border-radius: 0.5rem;
		background: var(--pk-bg);
		color: var(--pk-muted);
		font: 0.875rem var(--sl-font);
		cursor: pointer;
		transition: background-color 0.15s, color 0.15s;
	}
	.pk-search-trigger:hover {
		background: var(--pk-hover);
		color: var(--pk-fg);
	}
	.pk-search-label,
	.pk-search-kbd {
		display: none;
	}
	kbd {
		display: inline-flex;
		align-items: center;
		gap: 0.125rem;
		padding: 0.0625rem 0.375rem;
		border: 1px solid var(--pk-border);
		border-radius: 0.3125rem;
		background: var(--pk-subtle);
		color: var(--pk-muted);
		font: 500 0.6875rem/1.4 var(--sl-font);
	}
	@media (min-width: 50rem) {
		.pk-search-trigger {
			width: 15rem;
			justify-content: flex-start;
			padding-inline: 0.75rem 0.375rem;
		}
		.pk-search-label,
		.pk-search-kbd {
			display: inline-flex;
		}
		.pk-search-kbd {
			margin-inline-start: auto;
		}
	}

	.pk-search-dialog {
		width: min(40rem, calc(100vw - 2rem));
		max-height: min(32rem, calc(100dvh - 6rem));
		margin: 12vh auto auto;
		padding: 0;
		border: 1px solid var(--pk-border);
		border-radius: 0.875rem;
		background: var(--pk-bg);
		color: var(--pk-fg);
		box-shadow: 0 24px 64px rgb(0 0 0 / 0.18);
		overflow: hidden;
	}
	.pk-search-dialog[open] {
		display: flex;
	}
	.pk-search-dialog::backdrop {
		background: rgb(0 0 0 / 0.35);
		backdrop-filter: blur(2px);
	}
	.pk-search-panel {
		display: flex;
		flex-direction: column;
		width: 100%;
		min-height: 0;
	}
	.pk-search-field {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0 1rem;
		border-bottom: 1px solid var(--pk-border);
		color: var(--pk-muted);
	}
	.pk-search-field input {
		flex: 1;
		min-width: 0;
		height: 3.25rem;
		border: 0;
		background: transparent;
		color: var(--pk-fg);
		font: 1rem var(--sl-font);
		outline: none;
	}
	.pk-search-field input::-webkit-search-cancel-button {
		display: none;
	}
	.pk-search-close {
		padding: 0.125rem 0.5rem;
		border: 1px solid var(--pk-border);
		border-radius: 0.375rem;
		background: var(--pk-subtle);
		color: var(--pk-muted);
		font: 500 0.75rem var(--sl-font);
		cursor: pointer;
	}
	.pk-search-body {
		flex: 1;
		min-height: 0;
		overflow-y: auto;
		padding: 0.5rem;
		overscroll-behavior: contain;
	}
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	ul :global(li a) {
		display: grid;
		gap: 0.125rem;
		padding: 0.625rem 0.75rem;
		border-radius: 0.5rem;
		color: var(--pk-fg);
		text-decoration: none;
	}
	ul :global(li[aria-selected='true'] a) {
		background: var(--pk-hover);
	}
	ul :global(.pk-hit-path) {
		color: var(--pk-muted);
		font-size: 0.75rem;
	}
	ul :global(.pk-hit-title) {
		font-size: 0.9375rem;
		font-weight: 500;
	}
	ul :global(.pk-hit-text) {
		color: var(--pk-muted);
		font-size: 0.8125rem;
		line-height: 1.5;
	}
	ul :global(mark) {
		background: transparent;
		color: var(--pk-accent);
		font-weight: 600;
	}
	.pk-search-empty {
		margin: 0;
		padding: 2rem 1rem;
		color: var(--pk-muted);
		font-size: 0.875rem;
		text-align: center;
	}
	.pk-search-footer {
		display: none;
		gap: 1rem;
		padding: 0.625rem 1rem;
		border-top: 1px solid var(--pk-border);
		background: var(--pk-subtle);
		color: var(--pk-muted);
		font-size: 0.75rem;
	}
	.pk-search-footer span {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
	}
	@media (min-width: 50rem) {
		.pk-search-footer {
			display: flex;
		}
	}
</style>
