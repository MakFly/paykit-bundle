---
// Starlight's page title id (not exported): the TOC "Overview" link targets it.
const PAGE_TITLE_ID = '_top';

const t = Astro.locals.t;
const { entry, sidebar } = Astro.locals.starlightRoute;

// The breadcrumb is the sidebar group that contains the current page.
type Entry = (typeof sidebar)[number];
const findTrail = (entries: Entry[], trail: string[] = []): string[] | undefined => {
	for (const item of entries) {
		if (item.type === 'link' && item.isCurrent) return trail;
		if (item.type === 'group') {
			const found = findTrail(item.entries as Entry[], [...trail, item.label]);
			if (found) return found;
		}
	}
};
const trail = findTrail(sidebar) ?? [];
// The landing page draws its own hero: no breadcrumb, title or copy button.
const isSplash = entry.data.template === 'splash';
const markdown = `# ${entry.data.title}\n\n${entry.body ?? ''}`.trim();
---

{
	!isSplash && (
		<>
{
	trail.length > 0 && (
		<nav class="pk-breadcrumb" aria-label={t('pk.breadcrumb.label')}>
			<ol>
				{trail.map((label) => (
					<li>{label}</li>
				))}
				<li aria-current="page">{entry.data.title}</li>
			</ol>
		</nav>
	)
}
<div class="pk-title-row">
	<h1 id={PAGE_TITLE_ID}>{entry.data.title}</h1>
	<pk-copy-page data-markdown={markdown} data-copy={t('pk.copy.label')} data-copied={t('pk.copy.copied')} class="print:hidden">
		<button type="button" class="pk-copy">
			<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="13" height="13" rx="2"></rect><path d="M4 16V5a1 1 0 0 1 1-1h11"></path></svg>
			<span>{t('pk.copy.label')}</span>
		</button>
	</pk-copy-page>
</div>
{entry.data.description && <p class="pk-description">{entry.data.description}</p>}
		</>
	)
}

<script>
	class CopyPage extends HTMLElement {
		constructor() {
			super();
			const button = this.querySelector('button')!;
			const label = button.querySelector('span')!;
			const copyLabel = this.dataset.copy ?? '';
			const copiedLabel = this.dataset.copied ?? '';
			button.addEventListener('click', async () => {
				await navigator.clipboard.writeText(this.dataset.markdown ?? '');
				label.textContent = copiedLabel;
				setTimeout(() => (label.textContent = copyLabel), 2000);
			});
		}
	}
	customElements.define('pk-copy-page', CopyPage);
</script>

<style>
	.pk-breadcrumb ol {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		margin: 0 0 0.75rem;
		padding: 0;
		list-style: none;
		font-size: 0.875rem;
		color: var(--pk-muted);
	}
	.pk-breadcrumb li + li::before {
		content: '';
		display: inline-block;
		width: 0.375rem;
		height: 0.375rem;
		margin-inline-end: 0.625rem;
		border-top: 1.5px solid currentColor;
		border-right: 1.5px solid currentColor;
		transform: translateY(-0.1rem) rotate(45deg);
		opacity: 0.6;
	}
	.pk-breadcrumb [aria-current] {
		color: var(--pk-fg);
		font-weight: 500;
	}
	.pk-title-row {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}
	h1 {
		margin: 0;
		font-size: clamp(1.875rem, 1.5rem + 1.5vw, 2.25rem);
		line-height: 1.15;
		font-weight: 600;
		letter-spacing: -0.03em;
		color: var(--pk-fg);
	}
	.pk-copy {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		flex-shrink: 0;
		height: 2rem;
		margin-top: 0.25rem;
		padding-inline: 0.75rem;
		border: 1px solid var(--pk-border);
		border-radius: 0.5rem;
		background: var(--pk-bg);
		color: var(--pk-fg);
		font: 500 0.8125rem/1 var(--sl-font);
		cursor: pointer;
		transition: background 0.15s;
	}
	.pk-copy:hover {
		background: var(--pk-hover);
	}
	.pk-description {
		margin: 1.25rem 0 0;
		max-width: 42rem;
		font-size: 1.125rem;
		line-height: 1.6;
		color: var(--pk-muted);
	}
	@media (max-width: 40rem) {
		.pk-copy span {
			display: none;
		}
		.pk-copy {
			padding-inline: 0.5rem;
		}
	}
</style>
