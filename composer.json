{
    "name": "makfly/paykit-bundle",
    "description": "Embedded Stripe billing for Symfony: plans in config, feature gating, usage metering and webhooks. A Symfony port of PayKit (paykit.sh).",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["symfony", "bundle", "billing", "stripe", "subscriptions", "entitlements", "metering", "paykit"],
    "authors": [{"name": "Kevin Aubrée"}],
    "require": {
        "php": ">=8.2",
        "doctrine/doctrine-bundle": "^2.12",
        "doctrine/orm": "^3.2",
        "psr/clock": "^1.0",
        "psr/log": "^2.0|^3.0",
        "stripe/stripe-php": "^16.0|^17.0",
        "symfony/clock": "^7.1",
        "symfony/config": "^7.1",
        "symfony/console": "^7.1",
        "symfony/dependency-injection": "^7.1",
        "symfony/event-dispatcher": "^7.1",
        "symfony/framework-bundle": "^7.1",
        "symfony/http-kernel": "^7.1",
        "symfony/var-exporter": "^7.1"
    },
    "require-dev": {
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "symfony/security-bundle": "^7.1",
        "symfony/yaml": "^7.1",
        "twig/twig": "^3.10"
    },
    "suggest": {
        "symfony/security-bundle": "Enables the PAYKIT_FEATURE voter and the default security-based customer resolver",
        "twig/twig": "Enables paykit_* Twig functions",
        "doctrine/doctrine-migrations-bundle": "To run the bundled database migration"
    },
    "autoload": {"psr-4": {"PayKit\\Bundle\\": "src/", "PayKit\\Bundle\\Migrations\\": "migrations/"}},
    "autoload-dev": {"psr-4": {"PayKit\\Bundle\\Tests\\": "tests/"}},
    "config": {"sort-packages": true},
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G"
    },
    "minimum-stability": "stable"
}
