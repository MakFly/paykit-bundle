{
  "name": "paykit/example-api",
  "description": "Local Symfony API for the PayKit fullstack example",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "ext-pdo_sqlite": "*",
    "makfly/paykit-bundle": "^0.1@dev",
    "doctrine/doctrine-migrations-bundle": "^3.3",
    "symfony/dotenv": "^7.4",
    "symfony/framework-bundle": "^7.4",
    "symfony/yaml": "^7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "repositories": [{
    "type": "path",
    "url": "../../../..",
    "options": { "symlink": true, "versions": { "makfly/paykit-bundle": "0.1.x-dev" } }
  }],
  "autoload": { "psr-4": { "App\\": "src/", "App\\Migrations\\": "migrations/" } },
  "autoload-dev": { "psr-4": { "App\\Tests\\": "tests/" } },
  "scripts": { "test": "phpunit" },
  "config": { "sort-packages": true, "platform": { "php": "8.2.0" } }
}
